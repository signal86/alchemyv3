meta components;

create component: text {
    vars = ["text"];
    default = "text";
    html = "<p>{{text}}</p>";
};

meta view;

create text; # <p></p>
create text: a = "hello, world!"; # <p>hello, world!</p>
#syntax error
create text: b; # <p>/<p>
# warn test
create component: water {
    vars = ["flavor"];
    default = "wa";
    html = "<h1>{{flavor}}</p>";
};
b.text = "hello, world!"; # changes b to <p>hello, world!</p>
#syntax error
